set -eu
[[ ${1:-} == *password:* ]] || exit 1
[[ ${RUNNER_VM_KEYCHAIN_SERVICE:-} == com.selfhosted-runner.vm.* ]] || exit 1
[[ -n ${RUNNER_VM_ACCOUNT:-} ]] || exit 1
exec /usr/bin/security find-generic-password \
  -s "$RUNNER_VM_KEYCHAIN_SERVICE" -a "$RUNNER_VM_ACCOUNT" -w \
  "$HOME/Library/Keychains/login.keychain-db"
