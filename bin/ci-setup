#!/usr/bin/env python3
"""Entry point for the CI runner setup. Normally invoked via ../setup.zsh,
which bootstraps Homebrew and a modern python3 first."""

import pathlib
import sys

if sys.version_info < (3, 11):
    sys.exit(
        "ci-setup needs Python 3.11+ (Homebrew python3). "
        "Run it via ./setup.zsh, which bootstraps that."
    )

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))

from cisetup.main import main  # noqa: E402

raise SystemExit(main(sys.argv[1:]))
