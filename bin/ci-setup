"""Entry point for the CI runner setup. Normally invoked via ../setup,
which bootstraps Homebrew and a modern python3 first."""

import pathlib
import sys

if sys.version_info < (3, 11):
    sys.exit(
        "ci-setup needs Python 3.11+ (Homebrew python3). "
        "Run it via ./setup, which bootstraps that."
    )

# Python loads codecs lazily. If Homebrew upgrades this very interpreter
# while we run (brew phase), a late lazy import explodes — seen in the wild
# as `LookupError: unknown encoding: idna` on the first network call after
# hours of Xcode downloads. Import the lazy bits NOW, while the on-disk
# files still match the running process.
import encodings.idna  # noqa: F401

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))

from cisetup.main import main  # noqa: E402

raise SystemExit(main(sys.argv[1:]))
