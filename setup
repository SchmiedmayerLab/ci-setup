#!/bin/zsh
#
# This source file is part of the SchmiedmayerLab ci-setup open-source project
#
# SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
#
# SPDX-License-Identifier: MIT
#
#
# setup — bootstrap + entry point for the self-hosted CI runner setup.
#
# This script only guarantees the minimal foundation (Xcode Command Line
# Tools, Homebrew, a modern python3) and then hands off to the Python
# implementation in cisetup/. Everything is safe to re-run; re-runs only
# change what needs changing.
#
# Usage:
#   ./setup                        converge the machine (default)
#   ./setup status                 show current state
#   ./setup info                   summarize setup, services and tool versions
#   ./setup update                 fast-forward this checkout, then converge
#   ./setup logs                   show recent maintenance output
#   ./setup status --json          export a comparable runner inventory
#   ./setup compare snapshot.json  compare with another runner's inventory
#   ./setup store-pat [token]      save a GitHub PAT to the Keychain
#                                      (without a token: prints the PAT
#                                      requirements and prompts, input hidden)
#   ./setup uninstall              deregister the runner from GitHub
#   ./setup converge --non-interactive
#                                      what the boot LaunchAgent runs: never
#                                      prompts, never uses sudo

set -e
set -u
set -o pipefail

SCRIPT_DIR="${0:A:h}"

NONINTERACTIVE=0
SHOW_HELP=0
for arg in "$@"; do
  if [[ $arg == --non-interactive ]]; then
    NONINTERACTIVE=1
  fi
  if [[ $arg == --help || $arg == -h ]]; then
    SHOW_HELP=1
  fi
done

log()  { print -r -- "==> $*" }
fail() { print -r -- "setup: error: $*" >&2; exit 1 }

if [[ $(uname -s) != Darwin ]]; then
  fail "this only runs on macOS"
fi
if (( EUID == 0 )); then
  fail "do not run as root — the runner and its services are per-user"
fi

# --- store-pat (no bootstrap needed) -----------------------------------------
# Storing the PAT only needs macOS's own `security`, so handle it before any
# CLT/Homebrew/python bootstrapping: a factory-fresh Mac can store its PAT
# first thing. The service name must match KEYCHAIN_SERVICE in cisetup/config.py.

if [[ ${1:-} == store-pat ]] && (( ! SHOW_HELP )); then
  readonly KEYCHAIN_SERVICE="github-runner-pat"
  TOKEN="${2:-}"
  if [[ -n $TOKEN ]]; then
    if [[ ! $TOKEN =~ '^[A-Za-z0-9_.=+/~-]+$' ]]; then
      fail "that does not look like a GitHub PAT"
    fi
    # `security -i` reads the command from stdin, keeping the token off
    # security's argv (it was on setup's argv already — the caller's
    # choice — but it must not leak any further). The charset check above
    # guarantees the quoting below cannot be escaped.
    print -r -- "add-generic-password -U -a \"$USER\" -s \"$KEYCHAIN_SERVICE\" -w \"$TOKEN\"" \
      | /usr/bin/security -i || fail "could not store the PAT in the Keychain"
  else
    cat <<'EOF'
A GitHub personal access token (PAT) lets the setup register, re-register,
and deregister the runner via the GitHub API. Required rights:

  repository runner (github.scope = "repo"):
    classic PAT:       `repo` scope
    fine-grained PAT:  repository permission "Administration: write"

  organization runner (github.scope = "org"):
    classic PAT:       `admin:org` scope
    fine-grained PAT:  organization permission "Self-hosted runners: write"

Prefer a fine-grained PAT limited to exactly the target repo/org.
Create one at:
  https://github.com/settings/personal-access-tokens/new   (fine-grained)
  https://github.com/settings/tokens/new                   (classic)

The token is stored only in this machine's login Keychain (service
"github-runner-pat") — never in a file or the repo.

Usage:
  ./setup store-pat            prompt for the token (input hidden)
  ./setup store-pat <token>    store the given token

EOF
    if [[ ! -t 0 ]]; then
      fail "no token given and no terminal to prompt on"
    fi
    # `-w` without a value: security itself prompts (hidden, with confirmation).
    /usr/bin/security add-generic-password -U -a "$USER" -s "$KEYCHAIN_SERVICE" -w \
      || fail "could not store the PAT in the Keychain"
  fi
  log "PAT stored in the login Keychain (service: $KEYCHAIN_SERVICE)"
  exit 0
fi

# Read-only commands must never bootstrap this machine. Only use an already
# installed modern interpreter, and let Python report missing tooling.
READ_ONLY=0
for arg in "$@"; do
  case "$arg" in
    status|info|logs|compare|--help|-h) READ_ONLY=1 ;;
  esac
done
if (( READ_ONLY )); then
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"
  for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    if [[ -x $candidate ]] && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
      exec "$candidate" "$SCRIPT_DIR/bin/ci-setup" "$@"
    fi
  done
  fail "Python 3.11+ is needed to inspect setup; no changes were made"
fi

# launchd's fallback only covers the latest bootstrap attempt. Python captures
# normal runs into dated, retained logs and does not mirror into this file.
if [[ -n ${CI_SETUP_BOOT_AGENT:-} ]]; then
  mkdir -p "$HOME/Library/Logs/ci-runner-setup"
  : > "$HOME/Library/Logs/ci-runner-setup/bootstrap.log"
fi

# --- Xcode Command Line Tools (needed for git and by Homebrew) --------------

if ! /usr/bin/xcode-select -p &>/dev/null; then
  if (( NONINTERACTIVE )); then
    fail "Xcode Command Line Tools are missing; run ./setup interactively once"
  fi
  log "Xcode Command Line Tools are missing — requesting installation (GUI dialog)."
  /usr/bin/xcode-select --install || true
  fail "re-run ./setup once the Command Line Tools installation has finished"
fi

# --- Homebrew ----------------------------------------------------------------

find_brew() {
  local candidate
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x $candidate ]]; then
      print -r -- "$candidate"
      return 0
    fi
  done
  return 1
}

BREW_BIN="$(find_brew || true)"
if [[ -z $BREW_BIN ]]; then
  if (( NONINTERACTIVE )); then
    fail "Homebrew is missing; run ./setup interactively once"
  fi
  log "Installing Homebrew (its installer will ask for your password once)."
  typeset installer
  installer="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || fail "could not download the Homebrew installer (no network?)"
  /bin/bash -c "$installer"
  BREW_BIN="$(find_brew || true)"
  if [[ -z $BREW_BIN ]]; then
    fail "Homebrew installation did not complete"
  fi
fi

eval "$("$BREW_BIN" shellenv)"

# Make brew available in login shells too (handy when SSHing into the box).
if ! grep -qsF "brew shellenv" "$HOME/.zprofile"; then
  print -r -- "eval \"\$($BREW_BIN shellenv)\"" >> "$HOME/.zprofile"
fi

# --- Python >= 3.11 from Homebrew -------------------------------------------

PYTHON="$("$BREW_BIN" --prefix)/bin/python3"
if [[ ! -x $PYTHON ]]; then
  log "Installing python3 via Homebrew."
  # --yes: Homebrew 6 asks for confirmation before installing by default.
  "$BREW_BIN" install --quiet --yes python3
fi
if [[ ! -x $PYTHON ]]; then
  fail "expected Homebrew python3 at $PYTHON"
fi

# Self-update is performed by Python under the shared maintenance lock.

# --- Hand off to the Python implementation ----------------------------------

exec "$PYTHON" "$SCRIPT_DIR/bin/ci-setup" "$@"
