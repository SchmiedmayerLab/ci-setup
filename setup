#!/bin/zsh
#
# This source file is part of the macOS Self-Hosted GitHub Actions Runner open-source project
#
# SPDX-FileCopyrightText: 2026 Stanford University and the project authors (see CONTRIBUTORS.md)
#
# SPDX-License-Identifier: MIT
#
#
# setup — bootstrap + entry point for the self-hosted CI runner setup.
#
# This script only guarantees the minimal foundation (Xcode Command Line
# Tools, Homebrew, a modern python3) and then hands off to the Python
# implementation in cisetup/. Reruns check existing state and stop when
# automatic recovery would be unsafe.
#
# Usage:
#   ./setup prepare host           prepare interactively, then provision in background
#   ./setup install runner         guided setup of a dedicated physical runner
#   ./setup install host           guided setup of a host and runner VMs
#   ./setup                        converge the machine (default)
#   ./setup status                 show current state
#   ./setup info                   summarize setup, services and tool versions
#   ./setup update                 fast-forward this checkout, then converge
#   ./setup adopt ~/runner         maintain an existing runner without re-registering
#   ./setup register --runner-name NAME --registration-token-stdin
#                                  register a guest using a token piped by its host
#   ./setup logs                   show recent maintenance output
#   ./setup status --json          export a comparable runner inventory
#   ./setup compare snapshot.json  compare with another runner's inventory
#   ./setup store-pat              show PAT requirements, prompt with hidden input,
#                                      and save it in the login Keychain
#   ./setup uninstall              deregister the runner from GitHub
#   ./setup converge --non-interactive
#                                      what the boot LaunchAgent runs: never
#                                      prompts; privileged steps need existing authorization

set -e
set -u
set -o pipefail

SCRIPT_DIR="${0:A:h}"

NONINTERACTIVE=0
SHOW_HELP=0
for arg in "$@"; do
  if [[ $arg == --non-interactive ]]; then
    NONINTERACTIVE=1
  fi
  if [[ $arg == --help || $arg == -h ]]; then
    SHOW_HELP=1
  fi
done

log()  { print -r -- "==> $*" }
fail() { print -r -- "setup: error: $*" >&2; exit 1 }

if [[ $(uname -s) != Darwin ]]; then
  fail "this only runs on macOS"
fi
if (( EUID == 0 )); then
  fail "do not run as root — the runner and its services are per-user"
fi
if [[ ( ${1:-} == install || ${1:-} == prepare ) && ${2:-} == host ]] && (( ! SHOW_HELP )); then
  [[ $(uname -m) == arm64 ]] || fail "macOS runner VMs require an Apple silicon host"
  RUNNER_HOST_VERSION=$(/usr/bin/sw_vers -productVersion)
  (( ${RUNNER_HOST_VERSION%%.*} >= 27 )) || fail "automatic guest setup requires macOS 27+ on the host; update macOS before installing prerequisites"
fi

# --- store-pat (no bootstrap needed) -----------------------------------------
# Storing the PAT only needs macOS's own `security`, so handle it before any
# CLT/Homebrew/python bootstrapping: a factory-fresh Mac can store its PAT
# first thing. The service name must match KEYCHAIN_SERVICE in cisetup/config.py.

if [[ ${1:-} == store-pat ]] && (( ! SHOW_HELP )); then
  readonly KEYCHAIN_SERVICE="github-runner-pat"
  readonly LOGIN_KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"
  TOKEN="${2:-}"
  if [[ -z $TOKEN ]]; then
    cat <<'EOF'
A GitHub personal access token (PAT) lets the setup discover names, register,
re-register, and deregister runners. Prefer a fine-grained token:

  repository runner (github.scope = "repo"):
    Resource owner: the repository owner; select only the target repository.
    Repository permission: "Administration: Read and write"

  organization runner (github.scope = "org"):
    Resource owner: the destination organization.
    Organization permission: "Self-hosted runners: Read and write"
    No repository permissions are needed for organization runner management.

Your account needs administrative access to the destination. If the organization
requires token approval, wait for approval before continuing. Set an expiration
date and renew the stored token before it expires.

Optional: dispatching an existing validation workflow requires repository
"Actions: Read and write", limited to its repository. This is not required
to install or operate runners. Jobs use their own workflow credentials.

Classic tokens are also supported: `repo` for repository runners, `admin:org`
for organization runners (GitHub may also require `repo` for private resources).
Create one at:
  https://github.com/settings/personal-access-tokens/new   (fine-grained)
  https://github.com/settings/tokens/new                   (classic)

The token is stored only in this machine's login Keychain (service
"github-runner-pat") — never in a file or the repo.

Usage:
  ./setup store-pat            prompt for the token (input hidden)

EOF
    if [[ ! -t 0 ]]; then
      fail "no token given and no terminal to prompt on"
    fi
    read -rs 'TOKEN?GitHub token (hidden): ' || fail "token entry cancelled"
    print
  fi
  if [[ ! $TOKEN =~ '^[A-Za-z0-9_.=+/~-]+$' ]]; then
    fail "that does not look like a GitHub PAT"
  fi
  # Keep the secret off security's argv. Escape its interactive command syntax.
  KEYCHAIN_INPUT="${LOGIN_KEYCHAIN//\\/\\\\}"
  KEYCHAIN_INPUT="${KEYCHAIN_INPUT//\"/\\\"}"
  KEYCHAIN_ACCOUNT="$(/usr/bin/id -un)"
  print -r -- "add-generic-password -U -a \"$KEYCHAIN_ACCOUNT\" -s \"$KEYCHAIN_SERVICE\" -w \"$TOKEN\" \"$KEYCHAIN_INPUT\"" \
    | /usr/bin/security -i || fail "could not store the PAT in the Keychain"
  # Interactive security may exit zero after a failed subcommand. Verify without
  # printing the token or passing it to another process as an argument.
  STORED_TOKEN="$(/usr/bin/security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$KEYCHAIN_SERVICE" -w "$LOGIN_KEYCHAIN")" \
    || fail "could not verify the PAT in the login Keychain"
  [[ $STORED_TOKEN == $TOKEN ]] || fail "the stored PAT did not match"
  unset TOKEN STORED_TOKEN
  log "PAT stored in the login Keychain (service: $KEYCHAIN_SERVICE)"
  exit 0
fi

# Inspection and legacy adoption must not bootstrap before validation and
# pausing intake. Use an existing modern interpreter; adoption installs any
# missing managed packages later, inside the Python maintenance guard.
READ_ONLY=0
for arg in "$@"; do
  case "$arg" in
    host|status|info|logs|compare|adopt|register|--check|--help|-h) READ_ONLY=1 ;;
  esac
done
if [[ ${1:-} == install || ${1:-} == prepare ]] && (( ! SHOW_HELP )); then
  if [[ ${1:-} == prepare ]]; then
    [[ ${2:-} == host ]] || fail "usage: ./setup prepare host [options]"
  fi
  [[ ${2:-} == runner || ${2:-} == host ]] || fail "usage: ./setup install {runner|host} [options]"
  export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1
  # 'host' is otherwise an inspection command; guided installation needs the
  # shared foundation. A readiness check must never install prerequisites.
  READ_ONLY=0
  for arg in "$@"; do
    [[ $arg != --check && $arg != --prepared ]] || READ_ONLY=1
  done
fi
# Host bootstrap shares only the prerequisite installation below.
if [[ ${1:-} == host && ${2:-} == bootstrap ]] && (( ! SHOW_HELP )); then
  (( $# == 2 )) || fail "usage: ./setup host bootstrap"
  READ_ONLY=0
  export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1
fi
if (( READ_ONLY )); then
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"
  for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3 "${commands[python3]:-}"; do
    if [[ -x $candidate ]] && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
      exec "$candidate" "$SCRIPT_DIR/bin/ci-setup" "$@"
    fi
  done
  fail "Python 3.11+ is needed for this command; no changes were made"
fi

# launchd's fallback only covers the latest bootstrap attempt. Python captures
# normal runs into dated, retained logs and does not mirror into this file.
if [[ -n ${CI_SETUP_BOOT_AGENT:-} ]]; then
  mkdir -p "$HOME/Library/Logs/ci-runner-setup"
  : > "$HOME/Library/Logs/ci-runner-setup/bootstrap.log"
fi

# --- Xcode Command Line Tools (needed for git and by Homebrew) --------------

if ! /usr/bin/xcode-select -p &>/dev/null; then
  if (( NONINTERACTIVE )); then
    fail "Xcode Command Line Tools are missing; run ./setup interactively once"
  fi
  log "Xcode Command Line Tools are missing — requesting installation (GUI dialog)."
  /usr/bin/xcode-select --install || true
  fail "finish Command Line Tools in Apple’s installer or System Settings > General > Software Update, verify xcode-select -p, then rerun this same command"
fi

# --- Homebrew ----------------------------------------------------------------

find_brew() {
  local candidate
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x $candidate ]]; then
      print -r -- "$candidate"
      return 0
    fi
  done
  return 1
}

BREW_BIN="$(find_brew || true)"
if [[ -z $BREW_BIN ]]; then
  if (( NONINTERACTIVE )); then
    fail "Homebrew is missing; run ./setup interactively once"
  fi
  log "Installing Homebrew (its installer will ask for your password once)."
  typeset installer
  installer="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || fail "could not download the Homebrew installer (no network?)"
  /bin/bash -c "$installer"
  BREW_BIN="$(find_brew || true)"
  if [[ -z $BREW_BIN ]]; then
    fail "Homebrew installation did not complete"
  fi
fi

eval "$("$BREW_BIN" shellenv)"

# Make brew available in login shells too (handy when SSHing into the box).
if ! grep -qsF "brew shellenv" "$HOME/.zprofile"; then
  print -r -- "eval \"\$($BREW_BIN shellenv)\"" >> "$HOME/.zprofile"
fi

# --- Python >= 3.11 from Homebrew -------------------------------------------

PYTHON="$("$BREW_BIN" --prefix)/bin/python3"
if [[ ! -x $PYTHON ]]; then
  log "Installing python3 via Homebrew."
  # --yes: Homebrew 6 asks for confirmation before installing by default.
  "$BREW_BIN" install --quiet --yes python3
fi
if [[ ! -x $PYTHON ]]; then
  fail "expected Homebrew python3 at $PYTHON"
fi

# Self-update is performed by Python under the shared maintenance lock.

# --- Hand off to the Python implementation ----------------------------------

exec "$PYTHON" "$SCRIPT_DIR/bin/ci-setup" "$@"
